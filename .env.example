# WorkSync environment configuration template.
# Copy this file to `.env` at the project root and fill in real values.
# NEVER commit the real `.env` file — it is ignored by Git.

# Backend API port
PORT=3000

# Secret used to sign JWT tokens. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_URL=http://localhost:9000

# PostgreSQL connection settings used by the backend.
PGHOST=localhost
PGPORT=5432
PGDATABASE=worksync
PGUSER=postgres
PGPASSWORD=your_postgresql_password